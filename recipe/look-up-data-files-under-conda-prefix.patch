From f9847f577bd1ff81c10ce5e04416bff8ba6c2822 Mon Sep 17 00:00:00 2001
From: Matthew Feickert <matthew.feickert@cern.ch>
Date: Mon, 28 Sep 2026 09:52:33 -0600
Subject: [PATCH] fix: Look up data files under $CONDA_PREFIX/share/ff at
 runtime

ffopen searches for the fferr.dat, ffwarn.dat, and ffperm5.dat data files
in paths that are compiled into the library as Fortran string literals.
Substituting the conda build prefix into these literals does not work, as
the literals are not NUL-terminated and so the prefix replacement done
when the package is installed into a new prefix corrupts both the path
and the adjacent string literals.

Instead, first try $CONDA_PREFIX/share/ff/ at runtime using the Fortran
2003 get_environment_variable intrinsic, and then fall back to the
original search paths.
---
 src/ff/ffinit.f | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/ff/ffinit.f b/src/ff/ffinit.f
index c734fc4..6ac7ca3 100644
--- a/src/ff/ffinit.f
+++ b/src/ff/ffinit.f
@@ -756,6 +756,7 @@
 	character*(*) name
 *
 	logical lopen
+	integer istat
 	character*512 path,fullname
 *
 	include 'ff.h'
@@ -774,6 +775,15 @@
 *	fullname = 'USR$LOCAL[GEERT]'//name
 *	open(ifile,file=fullname,status='OLD',READONLY,err=100)
 *
+*	conda environments - look up the prefix at runtime as a path
+*	compiled into the library is not relocatable
+	call get_environment_variable('CONDA_PREFIX',path,status=istat)
+	if ( istat.eq.0 ) then
+	    fullname = trim(path)//'/share/ff/'//name
+	    open(ifile,file=fullname,status='OLD',err=25)
+	    return
+	endif
+   25	continue
 *	first try - my home directory
 	path = '/user/gj/lib/'
 	fullname = path(1:index(path,' ')-1)//name
-- 
2.55.0

